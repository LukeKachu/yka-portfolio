# Supabase public connection values. Safe for browser use; database RLS remains mandatory.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy alternative if your project only shows an anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Optional server-only automatic translation. Manual bilingual editing works without these.
TRANSLATION_PROVIDER=openai-compatible
TRANSLATION_API_URL=https://api.openai.com/v1/chat/completions
TRANSLATION_API_KEY=
TRANSLATION_MODEL=

# Required for contact form email delivery. Server-only; never use NEXT_PUBLIC_.
# CONTACT_FROM_EMAIL must be an address on your Resend-verified sending domain.
# Visitor email is Reply-To, never From. Destination is the portfolio owner's email.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Optional contact anti-bot protection. Configure BOTH to enable server enforcement.
# The site key is public, passed by the server at runtime (no build variable required).
# The secret key must remain server-only and be stored as a Cloudflare Secret.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional, server-only Cloudflare Stream. Never use NEXT_PUBLIC_ for these.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# Optional, server-only CV draft assistant. PDF upload and manual editing work without it.
RESUME_AI_API_KEY=
RESUME_AI_MODEL=
RESUME_AI_API_URL=https://api.openai.com/v1/chat/completions
